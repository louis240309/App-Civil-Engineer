# Never commit a real .env file. Copy this file to .env and fill values locally.
# Secrets stay on the backend only; the frontend must never receive them.

# Runtime
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (reserved for the data milestone; unused in the foundation build)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (reserved for the triage milestone; unused in the foundation build)
GEMINI_API_KEY=
